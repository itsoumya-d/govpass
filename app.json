{
  "expo": {
    "name": "GovPass",
    "slug": "govpass",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "govpass",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.govpass.app",
      "infoPlist": {
        "NSCameraUsageDescription": "GovPass uses your camera to scan government IDs and documents for auto-fill.",
        "NSPhotoLibraryUsageDescription": "GovPass accesses your photos to import document images.",
        "NSMicrophoneUsageDescription": "GovPass may use the microphone for voice input."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "permissions": ["android.permission.CAMERA", "android.permission.READ_EXTERNAL_STORAGE"],
      "package": "com.govpass.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow GovPass to access your camera to scan government documents."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow GovPass to access your photos to import document images."
        }
      ]
    ],
    "jsEngine": "hermes",
    "experiments": {
      "typedRoutes": true
    }
  }
}
