{
  "expo": {
    "name": "GovPass",
    "slug": "govpass",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "govpass",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.govpass.app",
      "infoPlist": {
        "NSCameraUsageDescription": "GovPass uses your camera to scan government IDs and documents for auto-fill.",
        "NSPhotoLibraryUsageDescription": "GovPass accesses your photos to import document images.",
        "NSMicrophoneUsageDescription": "GovPass may use the microphone for voice input.",
        "NSFaceIDUsageDescription": "Use Face ID to quickly and securely sign in to your account."
      },
      "buildNumber": "1",
      "associatedDomains": [
        "applinks:govpass.app"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "package": "com.govpass.app",
      "versionCode": 1,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "govpass.app",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow GovPass to access your camera to scan government documents."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow GovPass to access your photos to import document images."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#ffffff"
        }
      ],
      "@sentry/react-native/expo",
      "./plugins/withWidget"
    ],
    "jsEngine": "hermes",
    "experiments": {
      "typedRoutes": true
    }
  }
}
